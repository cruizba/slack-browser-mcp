{
  "name": "slack-browser-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Slack read access for any agent: browser login once, then the Slack Web API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "slack-browser": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "serve": "node --experimental-strip-types src/mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
