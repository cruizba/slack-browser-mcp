*.log

# Credentials never belong in the repository. The store lives in
# ~/.config/slack-browser-mcp/accounts, but ignore the shape here as well so a
# debugging export cannot slip into a commit.
accounts/
*.credentials.json
.env
.env.*
*.pem

# The browser profile and the forum file live outside the repository, but a run with
# both variables pointed here would drop them in the tree; the guard in
# internal/credentialguard is the second net.
profile/
forum.json
slack-browser-mcp/
bin/
coverage.out
coverage.html
*.test

# The release archives and the coverage report a local run leaves behind.
/coverage.out
/coverage.html
